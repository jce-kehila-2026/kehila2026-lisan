# Frontend build-time variables (Vite). Copy to frontend/.env and fill in.
# Never commit real values: this repository is public.

# Code teachers type in the admin dashboard to open teacher management
# (/admin/progress). If unset or empty, every code is rejected.
# It is baked into the built JS bundle, so treat it as a light gate only.
# Example: VITE_TEACHER_MGMT_CODE=<choose-a-private-code>
VITE_TEACHER_MGMT_CODE=
