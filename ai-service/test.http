Content-Type: application/json

{
  "message": "קריפטו וביטקוין",
  "level": "A1"
}

### 3.3 Blocked Topic - פוליטיקה (Politics)
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "פוליטיקה",
  "level": "A1"
}

###################################
# 4️⃣ LEVEL EXCEPTIONS
###################################

### 4.1 מניות in A1 (Should be Blocked)
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "מה זה מניות",
  "level": "A1"
}

### 4.2 מניות in B2 (Should be Allowed)
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "מה זה מניות",
  "level": "B2"
}

###################################
# 5️⃣ EXACT CACHE TESTS
###################################

### 5.1 Exact Cache - First Request
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "שלום מה שלומך",
  "level": "A1"
}

### 5.2 Exact Cache - Second Request (Should Hit Cache)
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "שלום מה שלומך",
  "level": "A1"
}

###################################
# 6️⃣ VOICE MODE
###################################

### 6.1 Voice Mode Request
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "שלום",
  "level": "A1",
  "voiceMode": true
}

###################################
# 7️⃣ MIXED ARABIC-HEBREW
###################################

### 7.1 Mixed Language - Arabic+Hebrew
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
Content-Type: application/json

{
  "message": "شو يعني בית",
  "level": "A1",
  "includeArabic": true
}

###################################
# 8️⃣ ANALYTICS & REPORTING
###################################

### 8.1 Analytics Report
GET {{base_url}}/api/ai/analytics
X-Internal-Service-Secret: {{secret}}

### 8.2 Health & Readiness
GET {{base_url}}/api/ai/ready
X-Internal-Service-Secret: {{secret}}

###################################
# 9️⃣ RATE LIMITING
###################################

### 9.1 With User ID Header
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
X-User-ID: test-user-123
Content-Type: application/json

{
  "message": "שלום",
  "level": "A1"
}

### 9.2 With Session ID Header
POST {{base_url}}/api/ai/chat
X-Internal-Service-Secret: {{secret}}
X-Session-ID: session-abc-def
Content-Type: application/json

{
  "message": "שלום",
  "level": "A1"
}

